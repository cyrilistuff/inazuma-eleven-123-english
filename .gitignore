# ===========================================================================
#  ROMs y material con copyright  ->  NUNCA se suben a GitHub
# ===========================================================================
roms/
*.3ds
*.nds
*.cia
*.cci
*.cxi
*.app
*.ncch
*.bin.dec

# Contenido extraído de las ROMs (RomFS / ExeFS / assets originales)
work/
romfs/
exefs/
extracted/
*.romfs
*.exefs

# Logos oficiales usados solo como referencia local para las pruebas de UI
logos/

# ROM traducida intermedia (solo se distribuye el .xdelta, no la ROM)
*_es.3ds
*_translated.3ds
build/

# ===========================================================================
#  Herramientas de terceros (se enlazan, no se re-suben)
# ===========================================================================
tools/bin/
*.exe
*.dll

# ===========================================================================
#  Basura del sistema / editores
# ===========================================================================
__pycache__/
*.pyc
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.log
*.tmp
.claude/
.claude/settings.local.json

# Diálogo oficial extraído del DS (copyright Nintendo): regenerar con tools/ds_official.py
translation/*/dialogo_oficial.csv
.firecrawl/

# Registro de errores de runtime cosechado de Azahar (tools/harvest_log.py):
# datos locales de la maquina (rutas, PCs). El registro persiste en local; a GitHub
# solo van las herramientas, no la cosecha.
logs/

# Paquete ie123kit (tools/pyproject.toml)
*.egg-info/
.pytest_cache/
.ruff_cache/
